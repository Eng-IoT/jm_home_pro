# Configure apenas no servidor. Nunca envie credenciais no chat.
JM_HOST=127.0.0.1
JM_PORT=8787
JM_ALLOWED_ORIGINS=http://localhost:8787,https://jm-home-casa-3d.jmm-engiot.chatgpt.site
# Chave aleatória com pelo menos 32 caracteres.
JM_ADMIN_TOKEN=
JM_DEVICES_FILE=gateway/devices.json
JM_DB_PATH=gateway/data/jm-connect.sqlite
JM_CONTROL_ENABLED=false
# Data center do projeto: us, us_east, eu, eu_west, cn, in, sg.
TUYA_REGION=
TUYA_CLIENT_ID=
TUYA_CLIENT_SECRET=
# Versão suportada no seu aplicativo Meta, no formato vNN.0.
WA_GRAPH_VERSION=
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=
# País e DDD, só dígitos, separados por vírgulas. Não incluir o próprio bot.
WA_ALLOWED_SENDERS=
WA_BOT_NUMBER=
WA_CONTROL_ENABLED=false
